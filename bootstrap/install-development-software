#!/usr/bin/env bash
# SPDX-License-Identifier: BSD-3-Clause

set -Eeuo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bootstrap/lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

require_macos_user
setup_homebrew

if ! xcode-select --print-path >/dev/null 2>&1; then
  log "Requesting installation of Apple's Command Line Tools"
  xcode-select --install || true
  die "Finish the Command Line Tools installer, then rerun this step."
fi

trust_tap clojure/tools
trust_tap borkdude/brew

formulae=(
  autoconf
  automake
  borkdude/brew/clj-kondo
  clang-format
  clojure/tools/clojure
  cmake
  flex
  gdb
  gettext
  lua-language-server
  meson
  multimarkdown
  open-mpi
  r
  shellcheck
  shfmt
  uv
)

development_casks=(
  "${JDK_CASK:-oracle-jdk}"
  # docker-desktop # Optional: uncomment to install Docker Desktop.
)

install_casks "${development_casks[@]}"
install_formulae "${formulae[@]}"

log "Installing Python command-line tools with uv"
uv tool install --upgrade llm
uv tool install --upgrade ruff
uv tool install --upgrade ty@latest

install_rust_toolchain() {
  local rustup_bin

  if command -v rustup >/dev/null 2>&1; then
    rustup_bin="$(command -v rustup)"
  elif [[ -x "$HOME/.cargo/bin/rustup" ]]; then
    rustup_bin="$HOME/.cargo/bin/rustup"
  else
    log "Installing Rust through rustup"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
      sh -s -- -y
    rustup_bin="$HOME/.cargo/bin/rustup"
  fi

  [[ -x "$rustup_bin" ]] || die "rustup was installed, but could not be found."

  log "Installing the stable Rust toolchain and editor components"
  "$rustup_bin" default stable
  "$rustup_bin" component add rust-analyzer rust-src clippy rustfmt
}

install_rust_toolchain
